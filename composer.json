{
    "name": "ez-simbs/app",
    "description": "Smart Inventory Management & Billing System",
    "type": "project",
    "require": {
        "php": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/core/",
            "App\\Config\\": "app/config/",
            "App\\Middleware\\": "app/middleware/",
            "App\\Exceptions\\": "app/exceptions/",
            "App\\Modules\\Auth\\": "modules/auth/classes/",
            "App\\Modules\\Catalog\\": "modules/catalog/classes/",
            "App\\Modules\\Purchasing\\": "modules/purchasing/classes/",
            "App\\Modules\\Sales\\": "modules/sales/classes/",
            "App\\Modules\\Reporting\\": "modules/reporting/classes/",
            "App\\Modules\\Administration\\": "modules/administration/classes/"
        },
        "files": [
            "includes/config.php",
            "includes/db.php",
            "includes/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}